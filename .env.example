# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Optional DNS resolvers for MongoDB Atlas SRV records (comma-separated)
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated browser origins. Localhost origins are also permitted for development.
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# File storage
FILE_STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Scheduler
SCHEDULER_API_KEY=replace-with-a-long-random-secret

# Do not keep bootstrap credentials in this file. Provide these only when
# executing `npm run seed:owner`.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_OWNER_NAME=System Owner
# BOOTSTRAP_OWNER_PHONE=0000000000
